# Optional. The defaults in backend/app/config.py already match the documented
# setup, so a fresh clone needs no .env at all. Copy this to .env only when you
# want to override something.

# The database is a SQLite file created on first run — there is nothing to
# install and no server to start. Set this only to move the file somewhere else,
# or to point the app at a real Postgres server instead.
# DATABASE_URL=sqlite+pysqlite:///C:/path/to/jobsearch.db

# Local LLM runtime + model. 11434 is a native Ollama install (`ollama serve`),
# which is what run.ps1 / run.sh sets up. If you instead run the bundled
# container (`docker compose --profile app up -d`), that one publishes 11435.
OLLAMA_URL=http://localhost:11434

# Leave this alone unless you have a reason. run.ps1 / run.sh measures the
# memory on the machine, picks a model that fits, and writes the choice here on
# first run. Setting it yourself turns that off, which is the point of setting
# it and also a good way to hand an 8 GB laptop a model it cannot hold.
#
# What they cost while running, measured with `ollama ps` at the 16k context
# this app uses, which is about double the download size:
#
#   llama3.2:1b   1.3 GB download   1.9 GB resident   chosen under 15 GB of RAM
#   llama3.2:3b   2.0 GB download   3.9 GB resident   chosen at 15 GB and up
#   llama3.1:8b   4.7 GB download   ~9 GB resident    only worth it on 32 GB
#
# Roughly 5 GB is already spoken for before the model loads: the OS, this app's
# backend, the web server and a browser. Whatever you set has to appear in
# `ollama list`.
# OLLAMA_MODEL=llama3.2:3b

# --- Optional: send the LLM work to a hosted model instead --------------------
#
# Leave all three empty and everything runs locally, which is the default and
# the point: nothing about your job search leaves your machine.
#
# Set them and it gets dramatically faster. A 3b model on a laptop CPU writes
# about thirteen tokens a second, so reading one job description takes about
# thirty seconds and tailoring a resume takes a minute and a half. The same work
# against a hosted model is about a second. Nothing else changes: same prompts,
# same checks, same refusal to print anything your knowledge base cannot back up.
#
# Any OpenAI-compatible endpoint works. Some that have a free tier:
#
#   Groq     LLM_BASE_URL=https://api.groq.com/openai/v1
#            LLM_MODEL=llama-3.3-70b-versatile
#
#   Gemini   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#            LLM_MODEL=gemini-2.0-flash
#
#   OpenRouter  LLM_BASE_URL=https://openrouter.ai/api/v1
#               LLM_MODEL=anthropic/claude-3.5-haiku
#
# The key is read from this file, sent to that provider, and nowhere else. Be
# aware of what this means: job descriptions and your knowledge base text are in
# those requests. That is exactly what the local default avoids, which is why
# this is off unless you turn it on. Both LLM_API_KEY and LLM_BASE_URL must be
# set; either one alone keeps everything local.
#
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=

# Embedding model — ONE model for everything that gets compared (KB + jobs).
# If you change the model, update EMBEDDING_DIM to its output dimension.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Minutes a generated resume is kept before it and its PDF are deleted.
# RESUME_TTL_MINUTES=10
