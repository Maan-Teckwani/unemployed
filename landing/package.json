{
  "name": "landing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "node scripts/check-copy.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "check:copy": "node scripts/check-copy.mjs",
    "test": "node --test \"tests/*.test.ts\"",
    "verify": "npm run lint && npm run check:copy && npm run test && npm run build",
    "db:init": "node --env-file=.env.local scripts/init-db.mjs",
    "seed:demo": "node --env-file=.env.local scripts/seed-demo.mjs",
    "seed:clear": "node --env-file=.env.local scripts/seed-demo.mjs --clear"
  },
  "dependencies": {
    "@dicebear/core": "10.3.2",
    "@dicebear/styles": "10.2.0",
    "@neondatabase/serverless": "^1.0.0",
    "@vercel/analytics": "^2.0.1",
    "framer-motion": "^12.43.0",
    "lenis": "^1.3.25",
    "next": "16.2.11",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
